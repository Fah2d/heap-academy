{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(/.githooks/**)",
      "Edit(/.git/config)",
      "Edit(/.git/hooks/**)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/scripts/claude-guard.mjs)",
      "Edit(/scripts/check-attribution.mjs)",
      "Edit(/scripts/pre-push.mjs)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git push --all *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * --delete *)",
      "Bash(git push --no-verify *)",
      "Bash(git push * --no-verify *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath *)",
      "Bash(git config set core.hooksPath *)",
      "Bash(git config unset core.hooksPath *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow disable *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit --visibility *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh"],
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.development",
        "./.env.development.local",
        "./.env.production",
        "./.env.production.local",
        "./.env.staging",
        "./.env.test",
        "./.env.test.local"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-guard.mjs\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
