# Every environment variable the application reads. The values here are fake.
# Real values live in the hosting provider and the CI environments, never in
# the repository (docs/spec/06-security-privacy.md section 5.5).
# Names starting with NEXT_PUBLIC_ are sent to the browser; nothing secret may use that prefix.

# Address of the Supabase project for this environment. Local: printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key for this environment. Safe in the browser; row level security decides access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# Cloudflare Turnstile site key for the bot challenge on the sign-in page. Public by design. This is Cloudflare's published test key, which always passes; production uses the real one.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Server only. Resend API key for the deletion record email to the owner (ADR-0030). Shares the 100-a-day cap with sign-in codes.
RESEND_API_KEY=re_example_not_a_real_key
# Server only, optional. The release in logs and in /api/health: the commit SHA, set by the deploy workflow at build. Unset, it is "local".
HEAP_RELEASE=local
