{
  "name": "heap-academy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "node scripts/build-runtime.mjs && next dev",
    "build": "node scripts/build-runtime.mjs && next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "attribution": "node scripts/check-attribution.mjs --branch && node scripts/check-attribution.mjs --files",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "infra:verify": "node scripts/infra-verify.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm attribution && pnpm test"
  },
  "dependencies": {
    "next": "16.4.6",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/css": "2.0.1",
    "@playwright/test": "1.65.1",
    "@types/estree": "1.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
